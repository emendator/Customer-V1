# 智能客服话术库系统 - 环境配置
# 复制此文件为 .env 并填写实际值

# 大模型 API 配置（OpenAI 兼容接口）
# 注意：API Key 不在 .env 中配置，统一从数据库按账号读取（各账号在「API Key 管理」页面设置）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 管理员初始 API Key（可选）
# 仅在系统初始化创建 admin 账号时生效一次；留空则不预设，管理员可在
# 「API Key 管理」页面自行配置。请勿把真实 Key 写进 init_db.py 等源码。
ADMIN_API_KEY=

# 服务配置
HOST=0.0.0.0
PORT=8002
DEBUG=true

# 数据库路径（留空则由 config.py 自动生成基于项目路径的绝对路径）
DATABASE_URL=

# 数据目录（可选，留空则为项目根目录下的 data/）
# DATA_DIR=D:/path/to/data

# 加密密钥 SECRET_KEY（强烈建议生产环境设置，用于 JWT 签名 + API Key 的 AES 加密）
# 不设置时，系统会首次启动自动生成强随机密钥并保存到 data/secret.key（勿删除）。
# 注意：更换 SECRET_KEY 后，历史加密的 API Key 需重新配置。
# SECRET_KEY=your-strong-random-secret
