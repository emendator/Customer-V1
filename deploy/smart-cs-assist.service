# ============================================================
# 智能客服话术库系统 - FastAPI 后端 systemd 服务
# 部署位置: /etc/systemd/system/smart-cs-assist.service
#
# 说明：
#   - 单 worker 运行（--workers 1）：避免多进程下 SQLite 并发写锁与内存会话不一致
#   - 以 www-data 用户运行，便于读写 /opt/smart-cs-assist/data/ 与 backend/users/
# ============================================================

[Unit]
Description=Smart CS Assist FastAPI Backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data

# 后端工作目录（app 包所在目录）
WorkingDirectory=/opt/smart-cs-assist/backend

# 启动命令：监听 127.0.0.1:8002，仅内网由 Nginx 反代
ExecStart=/opt/smart-cs-assist/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8002 --workers 1

Restart=always
RestartSec=3

Environment=PYTHONUNBUFFERED=1

# 上传/输出文件较多时提高文件描述符上限
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
